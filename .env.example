# Fictional local development only. These public passwords are not deployment secrets.
LOCAL_POSTGRES_PORT=55432
DATABASE_URL=postgres://recovery_app:local-demo-app@127.0.0.1:55432/recovery
ADMIN_DATABASE_URL=postgres://postgres:local-demo-admin@127.0.0.1:55432/recovery
TEST_DATABASE_URL=postgres://recovery_app:local-demo-app@127.0.0.1:55432/recovery_test
TEST_ADMIN_DATABASE_URL=postgres://postgres:local-demo-admin@127.0.0.1:55432/recovery_test

# Hosting: configure ONLY in the protected Vercel production environment.
# Never copy the local admin/test URLs above to Vercel. See DEPLOYMENT.md.
# DEMO_MODE=protected-fictional
# REVIEWER_ACCESS=vercel-auth-all-deployments
# APP_ORIGIN=https://your-assigned-reviewer.vercel.app
# REVIEWER_INSTANCE_ID=owner-demo
# DATABASE_URL=<restricted recovery_app pooled Neon TLS URL; secret>

# Explicitly authorized shared public demo only (instead of protected mode):
# DEMO_MODE=public-fictional
# REVIEWER_ACCESS=shared-public-fictional
# Everyone can impersonate fictional identities and change shared records.
